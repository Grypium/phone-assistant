#!/data/data/com.termux/files/usr/bin/python3
"""hear — record one spoken command and print the transcript (empty if nothing was said).

Works with the screen locked (Android's own recognizer doesn't): mic -> PulseAudio OpenSL ES source -> ffmpeg 16 kHz
-> end-of-speech detection -> whisper.cpp (offline). Exit 0 always; empty output = nothing heard.

Env: WHISPER_MODEL (base.en), HEAR_START_TIMEOUT (6 s to start talking), HEAR_MAX (20 s),
     HEAR_END_SILENCE (0.8 s of quiet ends the command).
  hear                      record, then transcribe
  hear --file WAV           transcribe an existing recording (the wake listener records "Hey Jarvis, <request>")
  hear --file WAV --strip-wake   ...and drop the leading wake word (WAKE_MODEL) from the text
"""
import os, re, subprocess, sys, time, wave
import numpy as np

P = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
W = os.path.join(P, "vendor", "whisper.cpp")
MODEL = os.environ.get("WHISPER_MODEL", "base.en")
START_TIMEOUT = float(os.environ.get("HEAR_START_TIMEOUT", "6"))
MAX_LEN = float(os.environ.get("HEAR_MAX", "20"))
END_SIL = float(os.environ.get("HEAR_END_SILENCE", "0.8"))
RATE, FRAME = 16000, 480            # 30 ms frames
OUT = os.path.join(P, "state", "last-command.wav")


sys.path.insert(0, os.path.join(P, "lib"))
import warnings; warnings.filterwarnings("ignore")


def log(msg):
    with open(os.path.join(P, "logs", "hear.log"), "a") as f:
        f.write(time.strftime("%F %T ") + msg + "\n")


def sh(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout


def record():
    from openwakeword.vad import VAD as _VAD      # loaded only when recording (--file mode doesn't need it)
    VAD = _VAD()
    if subprocess.run("pulseaudio --check", shell=True).returncode != 0:
        sh("pulseaudio --start --exit-idle-time=-1"); time.sleep(0.8)
    if "OpenSL_ES_source" not in sh("pactl list short sources"):
        sh("pactl load-module module-sles-source")
    parec = subprocess.Popen(["parec", "-d", "OpenSL_ES_source", "--raw", "--format=s16le", "--rate=44100", "--channels=2"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    ff = subprocess.Popen(["ffmpeg", "-v", "error", "-f", "s16le", "-ar", "44100", "-ac", "2", "-i", "-",
                           "-ar", str(RATE), "-ac", "1", "-f", "s16le", "-"],
                          stdin=parec.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    parec.stdout.close()
    frames = []
    started = None; last_voice = None; run = 0; peak = 0.0
    try:
        while True:
            buf = ff.stdout.read(FRAME * 2)
            if len(buf) < FRAME * 2:
                break
            frames.append(buf); now = len(frames) * FRAME / RATE
            # Silero VAD (shipped with openWakeWord): speech probability for this 30 ms frame. Unlike a loudness
            # threshold it doesn't need a quiet moment first, so talking right after the chime still works.
            prob = float(VAD.predict(np.frombuffer(buf, np.int16)))
            peak = max(peak, prob)
            if prob >= 0.5:
                run += 1; last_voice = now
                if started is None and run >= 3:            # ~90 ms of speech = you started talking
                    started = now - 0.09
            elif prob < 0.3:
                run = 0
            if started is None and now > START_TIMEOUT:
                break
            if started is not None and now - last_voice > END_SIL:
                break
            if now > MAX_LEN:
                break
    finally:
        for p in (parec, ff):
            try: p.kill()
            except Exception: pass
    log(f"recorded {len(frames) * FRAME / RATE:.1f}s, peak speech prob {peak:.2f}, "
        + (f"speech from {started:.1f}s" if started is not None else "no speech"))
    if started is None:
        return None
    keep = frames[max(0, int((started - 0.4) * RATE / FRAME)):]   # include 0.4 s before speech began
    with wave.open(OUT, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE); w.writeframes(b"".join(keep))
    return OUT


def audio_ctx(path):
    """Whisper always encodes 30 s of audio (context 1500). Less is faster, but too little costs accuracy: at 768 and
    below "Alexa, what is 2+2?" came out as "1 is 2+2", and 320 doubled a short phrase. 1024 was right and takes
    ~1.0 s (vs ~1.5 s for the full context)."""
    try:
        with wave.open(path) as w:
            dur = w.getnframes() / w.getframerate()
    except Exception:
        return 0
    if dur > 18:
        return 0                                         # 0 = full context
    return 1024


def threads():
    """whisper's threads spin-wait on each other, so more threads than usable cores is a disaster. With the screen
    locked (or another app in front) Android moves Termux to its background CPU group: 4 slower cores. 6 threads
    there took 18.8 s for a command that takes 0.9 s with 4. So: at most 4, and never more than we're allowed."""
    try:
        n = len(os.sched_getaffinity(0))
    except Exception:
        n = 4
    return max(1, min(4, n))


def cpu_group():
    try:
        return open("/proc/self/cpuset").read().strip()
    except Exception:
        return "?"


def transcribe(path):
    t0 = time.time(); nt = threads(); grp = cpu_group()
    env = dict(os.environ, LD_LIBRARY_PATH=os.path.join(W, "build", "bin"))
    out = subprocess.run([os.path.join(W, "build", "bin", "whisper-cli"), "-m",
                          os.path.join(W, "models", f"ggml-{MODEL}.bin"), "-f", path, "-t", str(nt),
                          "-ac", str(audio_ctx(path)), "-nt", "-np", "-l", "en"],
                         capture_output=True, text=True, env=env).stdout
    log(f"whisper: {time.time() - t0:.1f}s, {nt} threads, cpu group {grp}")
    text = " ".join(out.split())
    text = re.sub(r"\[[^\]]*\]|\([^)]*\)|\*[^*]*\*", "", text).strip()     # [BLANK_AUDIO], (wind), *music*
    if re.fullmatch(r"(?i)(thank you\.?|thanks for watching!?|you|\.|)", text):
        return ""                                                             # common hallucinations on noise
    return text


# How whisper tends to write each wake word (the recording starts with it when you say it all in one breath).
WAKE_SPELLINGS = {
    "hey_jarvis": r"jarvis|jarvas|jervis|javis|travis|davis|vis",
    "alexa": r"alexa|alexia|alexis|alexs?|lexa",
    "hey_mycroft": r"my ?croft|mycroft|microsoft|my craft|minecraft|croft",
    "hey_rhasspy": r"rhasspy|rhaspy|raspy|raspi|rasp(?:berry)? ?pi|haspy|ruspy",
}
_w = WAKE_SPELLINGS.get(os.environ.get("WAKE_MODEL", "hey_jarvis"), "|".join(WAKE_SPELLINGS.values()))
WAKE_PREFIX = re.compile(r"(?i)^\W*(?:(?:hey|hi|okay|ok|a)\W+)?(?:" + _w + r")\b\W*")


def strip_wake(text):
    out = WAKE_PREFIX.sub("", text, count=1).strip()
    return out[:1].upper() + out[1:] if out else ""


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--file" in args:
        wav = args[args.index("--file") + 1]
        text = transcribe(wav) if os.path.exists(wav) else ""
        if "--strip-wake" in args:
            text = strip_wake(text)
            if not re.search(r"[A-Za-z0-9]", text):
                text = ""
    else:
        wav = record()
        text = transcribe(wav) if wav else ""
    log(f"transcript: {text!r}")
    print(text)
