#!/data/data/com.termux/files/usr/bin/bash
# speak TEXT — say TEXT out loud and let the user interrupt it.
# speak -    read the reply from stdin as NUL-terminated chunks while it's still being written (bin/claude-stream),
#            so speaking starts with the first sentence. SPEAK_REPLY_FILE = the reply so far (for echo filtering).
#   say the wake word, e.g. "Hey Jarvis" (or "Hey Jarvis, stop") — interrupts, and the
#   caller should listen for a new request                                              -> exit 11
#   no wake listener running and unlocked: say "stop" (or cancel / quiet / never mind…) -> exit 10
#   either: the notification's "Stop talking" button (bin/shush)                        -> exit 10
# Exit 0 = finished.
#
# How: one termux-tts-speak process is started right away and fed one line per chunk (sentences; long ones split at
# commas). Starting a process per chunk cost ~1 s of silence before every sentence; this way the engine warms up while
# Claude is still thinking. Meanwhile a listener runs:
#  - the always-on wake word listener, locked or not: it reacts at once. (Android's recognizer, via
#    termux-speech-to-text -p, delivers its "partial" results only when its session ends, often 10+ s later, and
#    hangs on the lock screen.)
#  - only if that listener isn't running: a one-off wake word detector (locked), or Android's recognizer (unlocked),
#    where words that belong to the reply are ignored when looking for "stop" (echo cancellation isn't perfect).
# Interrupting kills the Termux:API process (via ADB): the speech engine drops everything queued and goes quiet at
# once, and the next TTS call starts it fresh. Without ADB the media volume is muted instead until the queue ends.
# (Killing termux-tts-speak itself doesn't stop the audio; force-stopping the engine leaves Termux:API stuck.)
P="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"; [ -f "$P/config.sh" ] && . "$P/config.sh"
S="$P/state"; mkdir -p "$S"; FLAG="$S/stop-speaking"; SAVED="$S/muted-volume"; SHUSH="$S/shush"
rm -f "$FLAG" "$SHUSH"

STREAM=; [ "$*" = - ] && { STREAM=1; exec 3<&0; }
text="$*"; [ -z "$STREAM" ] && [ -z "$text" ] && exit 0
reply_so_far(){ if [ -n "$STREAM" ]; then cat "${SPEAK_REPLY_FILE:-/dev/null}" 2>/dev/null; else printf '%s' "$text"; fi; }
killtree(){ local c; for c in $(pgrep -P "$1"); do killtree "$c"; done; kill "$1" 2>/dev/null; }
dbg(){ echo "$(date '+%T.%3N') $*" >> "$P/logs/speak.log"; }
music_vol(){ timeout 8 termux-volume 2>/dev/null | python3 -c "import sys,json;print([v['volume'] for v in json.load(sys.stdin) if v['stream']=='music'][0])" 2>/dev/null; }
unmute(){
  local v; v=$(cat "$SAVED" 2>/dev/null); rm -f "$SAVED"
  [[ "$v" =~ ^[0-9]+$ ]] && timeout 8 termux-volume music "$v" >/dev/null 2>&1
}
unmute   # left muted by a crash last time? put it back

is_stop(){ "$P/bin/is-stop" "$1" "$(reply_so_far)"; }   # a request to stop? (ignores words of the reply)

interrupt(){  # $1 = why (stop|wake), $2 = what was heard
  [ -f "$FLAG" ] && return
  echo "$1" > "$FLAG"                                   # first: nothing more is fed to the engine
  # log before anything slow: the main loop sees $FLAG, exits and kills this listener, maybe before we're done
  dbg "INTERRUPT ($1): $2"
  echo "$(date '+%F %T') interrupted ($1): $2" >> "$P/logs/conversation.log"
  if ! "$P/bin/heal-api" >/dev/null 2>&1; then          # no ADB: mute until the engine's queue runs out
    local v; v=$(music_vol); [[ "$v" =~ ^[1-9][0-9]*$ ]] && echo "$v" > "$SAVED"
    timeout 8 termux-volume music 0 >/dev/null 2>&1
  fi
  ( timeout 5 termux-vibrate -d 120 >/dev/null 2>&1 & )
}

split_text(){  # TEXT mode: the reply split into chunks, NUL-terminated
  printf '%s' "$text" | python3 -c '
import re,sys
out = []
for s in re.split(r"(?<=[.!?])\s+", sys.stdin.read().strip()):
    if len(s.split()) <= 14:
        out.append(s); continue
    cur = ""                                   # long sentence: split at , ; : - into chunks of >= 6 words
    for part in re.split(r"(?<=[,;:])\s+|\s+-\s+", s):
        cur = (cur + " " + part).strip()
        if len(cur.split()) >= 6:
            out.append(cur); cur = ""
    if cur:
        if out and len(cur.split()) < 3: out[-1] += " " + cur
        else: out.append(cur)
for s in out:
    if s.strip(): sys.stdout.write(s.strip() + "\0")'
}

# The speech engine: one termux-tts-speak, one line per chunk; it exits once everything fed to it has been spoken.
# Chunks come from fd 3 (stdin when streaming, else the split text). The feeder reads fd 3 directly (bash reads pipes
# byte by byte), so if it's killed to restart the engine, no chunk is lost. Fed lines are kept in $LINES for a replay.
LINES="$S/tts-lines"; : > "$LINES"
[ -z "$STREAM" ] && { split_text > "$S/tts-chunks"; exec 3<"$S/tts-chunks"; }
start_engine(){   # $1 = replay: feed the lines from the failed attempt first
  local fifo="$S/tts.fifo"; rm -f "$fifo"; mkfifo "$fifo"
  termux-tts-speak -s MUSIC < "$fifo" & tts=$!
  exec 4>"$fifo"; rm -f "$fifo"
  ( [ "${1:-}" = replay ] && cat "$LINES" >&4
    while IFS= read -r -d '' s <&3; do
      [ -f "$FLAG" ] && break
      s="${s//$'\n'/ }"; printf '%s\n' "$s" >> "$LINES"; printf '%s\n' "$s" >&4
      dbg "chunk: ${s:0:60}"
    done ) & feed=$!
  exec 4>&-          # only the feeder holds the engine's input: when it's done, the engine finishes and exits
}
# Is the phone actually talking? (ADB only; 2 = can't tell)
tts_playing(){
  local n; n=$(timeout 4 adb -s localhost:5555 shell "dumpsys audio | grep -c 'state:started.*CONTENT_TYPE_SPEECH'" 2>/dev/null | tr -d '\r')
  [[ "$n" =~ ^[0-9]+$ ]] || return 2
  [ "$n" -gt 0 ]
}
SPEAKING="$S/speaking"; touch "$SPEAKING"
start_engine

# the notification's "Stop talking" button
( while [ -f "$SPEAKING" ]; do
    [ -f "$SHUSH" ] && { interrupt stop "(Stop talking button)"; break; }
    sleep 0.15
  done ) & btn=$!

"$P/bin/is-locked"; locked=$?
wake_up=; [ -f "$S/wake.pid" ] && kill -0 "$(cat "$S/wake.pid")" 2>/dev/null && [ ! -f "$S/wake-paused" ] && wake_up=1
dbg "start: locked=$locked (0 locked,1 unlocked,2 unknown) -> listener=$([ -n "$wake_up" ] && echo wake-listener || { [ $locked != 1 ] && echo wake-word || echo recognizer; })"
if [ -n "$wake_up" ] || [ $locked != 1 ]; then
  if [ -n "$wake_up" ]; then
    # the always-on wake listener (already loaded) keeps listening during the reply and flags an interrupt
    rm -f "$S/wake-interrupt"; touch "$S/speaking-wake"
    ( while [ -f "$SPEAKING" ]; do
        [ -f "$S/wake-interrupt" ] && { interrupt wake "${WAKE_MODEL:-hey_jarvis}"; break; }
        sleep 0.15
      done ) & lis=$!
  else   # no listener running: start a one-off detector (takes several seconds to load)
    ( "$P/bin/wait-wake" && interrupt wake "${WAKE_MODEL:-hey_jarvis}" ) & lis=$!
  fi
else
  # Termux's PulseAudio keeps the mic open even when nothing reads it (suspending doesn't release it), and Android
  # then gives Google's recognizer only silence. Unload the mic module; the wake listener and hear reload it.
  pactl unload-module module-sles-source >/dev/null 2>&1
  # Fallback only: Termux:API hands over -p's partial results when the session ends, so "stop" lands late.
  ( while [ -f "$SPEAKING" ] && [ ! -f "$FLAG" ]; do
      timeout 12 termux-speech-to-text -p 2>/dev/null | while IFS= read -r heard; do
        [ -z "${heard// }" ] && continue
        dbg "heard: $heard"
        if is_stop "$heard"; then interrupt stop "$heard"; break; fi
      done
    done ) & lis=$!
fi

# Wait for the engine to finish. Once interrupted, stop at once (with ADB it's already silent).
# Termux:API's TTS sometimes hangs without a sound. Watchdogs:
#  - with ADB: speech must actually start within ~5 s of the first chunk; if not, restart Termux:API and the engine
#    and replay what was fed (once).
#  - always: give up after a generous estimate of the speaking time once everything has been fed.
fed_at=; heard_it=; checks=0; tick=0; retried=; can_check=1
while kill -0 "$tts" 2>/dev/null; do
  if [ -f "$FLAG" ]; then
    [ -f "$SAVED" ] || break                            # silenced: done. Muted instead: let the queue drain
  fi
  tick=$((tick + 1))
  if [ -z "$heard_it" ] && [ $can_check = 1 ] && [ -s "$LINES" ] && [ $((tick % 10)) = 0 ]; then
    tts_playing; r=$?; dbg "speech check: $r (0 playing, 1 silent, 2 can't tell)"
    if [ $r = 0 ]; then heard_it=1
    elif [ $r = 2 ]; then can_check=0
    else
      checks=$((checks + 1))
      if [ $checks -ge 5 ]; then
        if [ -z "$retried" ]; then
          dbg "no speech 5 s after the first chunk: restarting Termux:API and the engine"
          retried=1; killtree "$feed"; "$P/bin/heal-api" >/dev/null 2>&1; killtree "$tts"; sleep 0.5
          start_engine replay; checks=0; fed_at=; continue
        fi
        dbg "still no speech after a restart: giving up"; break
      fi
    fi
  fi
  if [ -z "$fed_at" ] && ! kill -0 "$feed" 2>/dev/null; then
    fed_at=$SECONDS; words=$(wc -w < "$LINES")
  fi
  if [ -n "$fed_at" ] && [ $((SECONDS - fed_at)) -gt $(( words / 2 + 8 )) ]; then
    # slow speech ("one... two... three...") can outlast the estimate: if it's audibly still talking, wait more
    if [ $can_check = 1 ] && tts_playing; then fed_at=$SECONDS; words=8; continue; fi
    dbg "engine hung: restarting Termux:API"; "$P/bin/heal-api"; break
  fi
  sleep 0.1
done
rm -f "$SPEAKING"
killtree "$feed"; exec 3<&- 0</dev/null   # streaming: closing our input makes bin/claude-stream stop Claude
killtree "$tts"; killtree "$lis"; killtree "$btn"; wait 2>/dev/null; sleep 0.2   # free the recognizer
rm -f "$S/speaking-wake" "$S/wake-interrupt" "$SHUSH" "$S/tts-chunks"
unmute
if [ -f "$FLAG" ]; then
  why=$(cat "$FLAG"); rm -f "$FLAG"
  [ "$why" = wake ] && exit 11          # caller listens for the new request right away (it plays the chime)
  paplay "$P/assets/stopped.wav" 2>/dev/null
  exit 10
fi
exit 0
